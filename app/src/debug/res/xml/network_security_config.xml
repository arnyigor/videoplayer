<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only override. Local fixture servers run over plain HTTP on the loopback address, while the
  production configuration (src/main) forbids cleartext. Release builds never see this file.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <!-- Debug keeps user CAs (as main's debug-overrides did); only one debug-overrides per app. -->
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
