<?xml version="1.0" encoding="utf-8"?>
<!--
    windowBackground и первый кадр сплэша: однотонный фон (без градиента и логотипа).
    Совпадает с системным splash Android 12+ (windowSplashScreenBackground), поэтому
    холодный старт выглядит как один непрерывный экран: тёмный фон → логотип и версия
    появляются один раз внутри активности, без «перескока» композиции.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/colorPrimaryDark" />
</layer-list>
