<?xml version="1.0" encoding="utf-8"?>
<!-- Единая сцена сплэша: тот же фон, что и в стартовом окне (bg_splash_window),
     центрированный логотип и версия приложения внизу. Без анимаций и переходов. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_window"
    android:contentDescription="@string/app_brand">

    <ImageView
        android:id="@+id/splashLogo"
        android:layout_width="288dp"
        android:layout_height="288dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/play_circle_outline" />

    <TextView
        android:id="@+id/splashVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:paddingBottom="32dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:textSize="14sp"
        android:textColor="@color/textColorSecondary" />
</FrameLayout>
