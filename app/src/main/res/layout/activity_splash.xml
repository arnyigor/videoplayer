<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <!--
        Вся сцена — один вертикальный блок, отцентрованный в родителе.
        Так геометрия не зависит от поведения цепочек ConstraintLayout.
    -->
    <LinearLayout
        android:id="@+id/splashStage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Сонар-волны лежат под иконкой и растут из неё. -->
        <!-- clipChildren=false: сонар-волны растут за пределы рамки, иначе арки обрезаются. -->
        <FrameLayout
            android:id="@+id/logoStage"
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <View
                android:id="@+id/ringOuter"
                android:layout_width="168dp"
                android:layout_height="168dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_splash_ring" />

            <View
                android:id="@+id/ringInner"
                android:layout_width="168dp"
                android:layout_height="168dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_splash_ring" />

            <ImageView
                android:id="@+id/ivSplashLogo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_brand"
                android:src="@drawable/play_circle_outline"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!-- Заголовок: текст + бегущий блик поверх него. -->
        <FrameLayout
            android:id="@+id/titleStage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp">

            <TextView
                android:id="@+id/tvSplashTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/app_brand"
                android:textColor="@color/textColorPrimary"
                android:textSize="26sp"
                android:textStyle="bold" />

        </FrameLayout>

        <!-- Индикатор ожидания: три пульсирующие точки читаются однозначнее кольца. -->
        <LinearLayout
            android:id="@+id/llSplashDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_splash_dot" />

            <View
                android:id="@+id/dot2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_splash_dot" />

            <View
                android:id="@+id/dot3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_splash_dot" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
