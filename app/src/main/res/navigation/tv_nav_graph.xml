<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/tv_nav_graph"
        app:startDestination="@id/tvHomeFragment">

    <fragment
            android:id="@+id/tvHomeFragment"
            android:name="com.arny.mobilecinema.presentation.tv.home.TvComposeHomeFragment"
            android:label="Home">
        <action
                android:id="@+id/actionToSearch"
                app:destination="@id/tvSearchFragment" />
        <action
                android:id="@+id/actionToSiteSearch"
                app:destination="@id/tvSiteSearchFragment" />
        <action
                android:id="@+id/actionToDetails"
                app:destination="@id/tvDetailsFragment" />
        <action
                android:id="@+id/actionToPlayer"
                app:destination="@id/tvPlayerFragment" />
        <action
                android:id="@+id/actionToCatalog"
                app:destination="@id/tvCatalogFragment" />
    </fragment>

    <fragment
            android:id="@+id/tvCatalogFragment"
            android:name="com.arny.mobilecinema.presentation.tv.catalog.TvCatalogFragment"
            android:label="Catalog">
        <argument
                android:name="section"
                app:argType="string"
                android:defaultValue="FILMS" />
        <action
                android:id="@+id/actionToDetails"
                app:destination="@id/tvDetailsFragment" />
    </fragment>

    <fragment
            android:id="@+id/tvDetailsFragment"
            android:name="com.arny.mobilecinema.presentation.tv.details.TvComposeDetailsFragment"
            android:label="Details">
        <argument
                android:name="movieId"
                app:argType="long" />
        <action
                android:id="@+id/actionToPlayer"
                app:destination="@id/tvPlayerFragment">
            <argument
                    android:name="movieId"
                    app:argType="long" />
            <argument
                    android:name="seasonIndex"
                    app:argType="integer"
                    android:defaultValue="0" />
            <argument
                    android:name="episodeIndex"
                    app:argType="integer"
                    android:defaultValue="0" />
        </action>
    </fragment>

    <fragment
            android:id="@+id/tvPlayerFragment"
            android:name="com.arny.mobilecinema.presentation.tv.player.TvPlayerFragment"
            android:label="Player">
        <argument
                android:name="movieId"
                app:argType="long"
                android:defaultValue="0L" />
        <argument
                android:name="sharedUrl"
                app:argType="string"
                android:defaultValue="" />
        <argument
                android:name="seasonIndex"
                app:argType="integer"
                android:defaultValue="0" />
        <argument
                android:name="episodeIndex"
                app:argType="integer"
                android:defaultValue="0" />
        <action
                android:id="@+id/actionToHome"
                app:destination="@id/tvHomeFragment"
                app:popUpTo="@id/tvHomeFragment"
                app:popUpToInclusive="true" />
        <action
                android:id="@+id/actionToDetails"
                app:destination="@id/tvDetailsFragment" />
    </fragment>

    <fragment
            android:id="@+id/tvSearchFragment"
            android:name="com.arny.mobilecinema.presentation.tv.search.TvSearchFragment"
            android:label="Search">
        <action
                android:id="@+id/actionToDetails"
                app:destination="@id/tvDetailsFragment" />
    </fragment>

    <fragment
            android:id="@+id/tvSiteSearchFragment"
            android:name="com.arny.mobilecinema.presentation.tv.search.TvSiteSearchFragment"
            android:label="Site search">
        <action
                android:id="@+id/actionToDetails"
                app:destination="@id/tvDetailsFragment" />
    </fragment>
</navigation>
