<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ всегда рисует системный splash. Его однотонный фон совпадает
         со статичной заставкой приложения; дополнительной анимации нет. -->
    <style name="AppTheme.Splash" parent="@style/AppTheme">
        <!-- Одинаковый статичный фон окна и содержимого активности. -->
        <item name="android:windowBackground">@drawable/bg_splash_window</item>
        <item name="android:windowSplashScreenBackground">@color/colorPrimaryDark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_invisible</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
    </style>
</resources>