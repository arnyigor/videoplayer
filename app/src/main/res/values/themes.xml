<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <item name="android:windowBackground">@color/colorPrimaryDark</item>
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:textColorPrimary">@color/textColorPrimary</item>
        <item name="android:textColorSecondary">@color/textColorSecondary</item>
        <item name="android:textColorHint">@color/textColorSecondary</item>

        <item name="android:dialogTheme">@style/MyDialogStyle</item>
        <item name="alertDialogTheme">@style/MyDialogStyle</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:itemTextAppearance">@style/ItemMenuTextAppearance</item>
        <item name="popupMenuStyle">@style/popupMenuStyle</item>
        <item name="actionOverflowMenuStyle">@style/popupMenuStyle</item>
        <item name="android:actionOverflowMenuStyle">@style/popupMenuStyle</item>

        <item name="md_background_color">@color/colorPrimaryDark</item>
        <item name="md_color_title">@color/textColorPrimary</item>
        <item name="md_color_content">@color/textColorPrimary</item>
        <item name="md_color_button_text">@color/textColorSecondary</item>
        <item name="md_corner_radius">8dp</item>

        <!-- Цвет курсора/выделения/активных контролов: без него на тёмном фоне
             курсор и ручки выделения почти чёрные. -->
        <item name="colorControlActivated">@color/colorAccent</item>

        <!-- Кнопки без своей стилизации (например, «Искать» на экране поиска по сайту)
             по умолчанию берут colorPrimary — тёмную на тёмном фоне. -->
        <item name="materialButtonStyle">@style/AccentButton</item>
    </style>

    <!-- S-021: меню в цветах приложения, а не белая плашка на тёмном экране. -->
    <style name="ItemMenuTextAppearance" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:itemBackground">@color/colorPrimaryDark</item>
    </style>

    <style name="popupMenuStyle" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@color/colorPrimaryDark</item>
        <item name="android:itemBackground">@color/colorPrimaryDark</item>
        <item name="android:colorBackground">@color/colorPrimaryDark</item>
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="actionOverflowMenuStyle">@style/popupMenuStyle</item>
    </style>

    <!--Input label style-->
    <style name="InputTextStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="boxBackgroundColor">@color/colorPrimaryDark</item>
        <item name="colorControlNormal">@color/textColorPrimary</item>
        <item name="colorControlActivated">@color/textColorPrimary</item>
        <item name="hintTextColor">@color/textColorPrimary</item>
        <item name="boxStrokeColor">@color/text_input_box_stroke</item>
    </style>

<style name="AppAlertDialogTheme" parent="Theme.MaterialComponents.Dialog.Alert">
    <item name="colorPrimary">@color/colorAccent</item>
    <item name="colorAccent">@color/colorAccent</item>
    <item name="colorSurface">@color/colorPrimaryDark</item>
    <item name="colorOnSurface">@color/textColorPrimary</item>
    <item name="android:colorBackground">@color/colorPrimaryDark</item>
    <item name="android:textColorPrimary">@color/textColorPrimary</item>
    <item name="android:textColorSecondary">@color/textColorSecondary</item>
    <item name="materialButtonStyle">@style/DialogButtonStyle</item>
</style>

<style name="MyDialogStyle" parent="Theme.MaterialComponents.Dialog">
        <!-- Радиокнопки/чекбоксы в диалогах: единый акцент вместо вторичного бирюзового. -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorControlActivated">@color/colorAccent</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:background">@color/colorPrimaryDark</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:textViewStyle">@style/DialogTextViewStyle</item>
        <item name="windowFixedWidthMajor">90%</item>
        <item name="windowFixedWidthMinor">90%</item>
        <item name="textColorAlertDialogListItem">@color/textColorPrimary</item>
        <item name="colorControlNormal">@color/colorAccent</item>
        
        <!-- Цвета кнопок -->
        <item name="materialButtonStyle">@style/DialogButtonStyle</item>

        <!-- AlertDialog.Builder внутри диалога берёт эту тему; без неё заголовок
             и текст оставались системными и в светлом режиме были тёмными на тёмном. -->
        <item name="alertDialogTheme">@style/AppAlertDialogTheme</item>
        <item name="android:alertDialogTheme">@style/AppAlertDialogTheme</item>
        <item name="colorSurface">@color/colorPrimaryDark</item>
        <item name="colorOnSurface">@color/textColorPrimary</item>
        <item name="android:textColorPrimary">@color/textColorPrimary</item>
        <item name="android:textColorSecondary">@color/textColorSecondary</item>
    </style>

    <style name="DialogButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/colorAccent</item>
    </style>

    <style name="DialogTextViewStyle" parent="android:Widget.TextView">
        <item name="android:textColor">@color/textColorPrimary</item>
    </style>

    <!-- Статичный стартовый экран: окно и StartActivity показывают один и тот же фон. -->
    <style name="AppTheme.Splash" parent="@style/AppTheme">
        <!-- С логотипом в фоне холодный старт не показывает пустой градиент. -->
        <item name="android:windowBackground">@drawable/bg_splash_window</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
    </style>

<!-- TV Styles -->
    <style name="AppTheme.TV" parent="Theme.Leanback">
        <!-- Платформенные диалоги берут активный цвет контролов из темы активности. -->
        <item name="android:colorControlActivated">@color/colorAccent</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <!-- Штатный стиль подзаголовка ограничен одной строкой: год/сезоны/страны/рейтинги
             обрезались многоточием. -->
        <item name="detailsDescriptionSubtitleStyle">@style/TvDetailsDescriptionSubtitleStyle</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/colorPrimaryDark</item>
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:dialogTheme">@style/TvDialogTheme</item>
        <item name="alertDialogTheme">@style/TvDialogTheme</item>
    </style>

    <style name="TvDetailsDescriptionSubtitleStyle" parent="Widget.Leanback.DetailsDescriptionSubtitleStyle">
        <item name="android:maxLines">6</item>
    </style>

    <style name="TvDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:textColorPrimary">@color/textColorPrimary</item>
        <item name="android:windowBackground">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Радиокнопки в списках выбора берут вторичный акцент; сводим к основному. -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorControlActivated">@color/colorAccent</item>
        <item name="android:colorControlActivated">@color/colorAccent</item>
        <item name="android:windowTitleStyle">@style/DialogTitleStyle</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="DialogTitleStyle">
        <item name="android:textColor">@color/textColorPrimary</item>
    </style>
</resources>