<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="tv_settings_title">Настройки</string>
    <string name="tv_library_empty">Здесь пока нет фильмов и сериалов</string>
    <string name="tv_home_empty">Каталог пуст. Откройте настройки, чтобы загрузить базу.</string>
    <string name="tv_autoplay_on">Автопереход: включён</string>
    <string name="tv_autoplay_off">Автопереход: выключен</string>
    <string name="tv_shared_link_error">Не удалось открыть фильм или сериал по ссылке.</string>
    <string name="tv_catalog_confirm">Обновить весь каталог обходом сайта? Это может занять длительное время.</string>
    <style name="TvNavigationButton" parent="android:style/Widget.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/tv_navigation_background</item>
        <item name="android:textColor">@color/tv_navigation_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:focusable">true</item>
        <item name="android:nextFocusRight">@id/tv_nav_host_fragment</item>
